# ── รันในเครื่อง (bun run dev) ─────────────────────────
DATABASE_URL="postgresql://user@localhost:5432/darin_payroll?schema=public"
SESSION_TTL_DAYS=30

# ── docker compose ใช้ตัวแปรพวกนี้ประกอบ DATABASE_URL เอง ─
POSTGRES_USER=darin
POSTGRES_PASSWORD=          # ต้องตั้ง ไม่มีค่า default — สุ่มด้วย: openssl rand -base64 24
POSTGRES_DB=darin_payroll
APP_PORT=3000

# รหัส owner ตอน seed ครั้งแรก — ไม่ใส่ = ระบบสุ่มให้แล้วพิมพ์ใน log ครั้งเดียว
# OWNER_PASSWORD=

# ── Google Sheet ───────────────────────────────────────
GOOGLE_SHEET_LINK="https://docs.google.com/spreadsheets/d/<id>/edit"

# ใส่ 2 ตัวนี้ถ้าจะปิดชีตไม่ให้แชร์สาธารณะ (ระบบสลับไปใช้ Sheets API เอง)
# GOOGLE_SA_EMAIL=xxx@yyy.iam.gserviceaccount.com
# GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
