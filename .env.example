# ── รันในเครื่อง (bun run dev) ─────────────────────────
DATABASE_URL="postgresql://user@localhost:5432/darin_payroll?schema=public"
SESSION_TTL_DAYS=30

# ── docker compose ใช้ตัวแปรพวกนี้ประกอบ DATABASE_URL เอง ─
POSTGRES_USER=darin
POSTGRES_PASSWORD=          # ต้องตั้ง ไม่มีค่า default
POSTGRES_DB=darin_payroll
APP_PORT=3000

# ── Google Sheet ───────────────────────────────────────
GOOGLE_SHEET_LINK="https://docs.google.com/spreadsheets/d/<id>/edit"

# ใส่ 2 ตัวนี้ถ้าจะปิดชีตไม่ให้แชร์สาธารณะ (ระบบสลับไปใช้ Sheets API เอง)
