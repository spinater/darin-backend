#
# ## สัญญา
#
# `mask_and_strip(line)` คืนบรรทัดเดิมที่ **เนื้อซึ่งไม่ใช่โค้ดถูกเป่าเป็น `\001`** (ความยาวคงเดิม
# ⇒ ตำแหน่งตัวอักษรยังตรงกับบรรทัดจริง) และตัดคอมเมนต์ท้ายบรรทัดทิ้ง ·
# `is_word(s, pos, w)` คืน 1 เมื่อ `w` ที่ตำแหน่ง `pos` เป็น **คำเดี่ยว** ไม่ใช่ชิ้นส่วนของคำอื่น
# (`rows.sort()` จึงไม่ใช่คำว่า `sort` เพราะตัวหน้าเป็น `.`)
#
# ⚠️ ผู้เรียกต้องโหลดไฟล์นี้ **คู่กับ** ตัวอ่านของตัวเองเสมอ:
#   awk -f scripts/lib/heredoc.awk -f scripts/lib/shell-mask.awk -f <ตัวอ่าน>.awk <ไฟล์>
# โหลดไม่ครบ = awk มองเป็น "เรียกฟังก์ชันที่ไม่มี" แล้วตายทั้งรอบ ซึ่งดังพอ · แต่ด่านทั้งสองใบ
# ยังมียามอ่านไฟล์ครบไว้ข้างหน้าอีกชั้น
function mask_and_strip(s,   i, c, out, insq, indq, prev, sd, d) {
  # เป่าเนื้อที่ **ไม่ใช่โค้ด** ให้เป็น \001 (คงความยาว) แล้วตัดคอมเมนต์ท้ายบรรทัด
  #
  # 🔑 กติกาสองข้อที่ต้องอยู่ด้วยกัน มิฉะนั้นได้บั๊กคนละทิศ:
  #   · เนื้อใน `'…'` เป็นข้อมูลล้วน ⇒ เป่าทิ้งทั้งหมด
  #   · เนื้อใน `"…"` เป็น **ร้อยแก้ว** ⇒ เป่าทิ้งด้วย **ยกเว้น** `$( … )` และ backtick ที่ไม่ถูก
  #     escape ซึ่งเป็นโค้ดจริง · รีโปนี้มีทั้งสองแบบเยอะ: `"$(git … | tr …)"` เป็นจุดเรียกจริง
  #     ส่วน `echo "… (git track ไว้ $n) …"` กับ `echo "… \`git mv\` …"` เป็นภาษาไทยล้วน
  #     ⇒ ไม่เป่า = แดงปลอมในร้อยแก้ว · เป่าหมด = จุดเรียกจริงหายเงียบ (คนละทิศ คนละราคา)
  out = ""; insq = 0; indq = 0; sd = 0; d = 0
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    prev = (i > 1) ? substr(s, i - 1, 1) : " "
    if (insq) { out = out ((c == "'") ? c : "\001"); if (c == "'") insq = 0; continue }
    if (indq && sd == 0) {
      if (c == "\"" && prev != "\\") { indq = 0; out = out c; continue }
      if (c == "$" && substr(s, i + 1, 1) == "(") { sd = 1; d = 1; out = out "$("; i++; continue }
      if (c == "`" && prev != "\\") { sd = 2; out = out c; continue }
      out = out "\001"; continue
    }
    if (indq && sd == 1) {
      if (c == "(") d++
      else if (c == ")") { d--; if (d == 0) sd = 0 }
    }
    else if (indq && sd == 2) { if (c == "`" && prev != "\\") sd = 0 }
    if (c == "'" && !indq) { insq = 1; out = out c; continue }
    if (c == "\"" && prev != "\\" && !indq) { indq = 1; out = out c; continue }
    if (!indq && c == "#" && (i == 1 || prev == " " || prev == "\t" || prev == "(" || prev == ";")) break
    out = out c
  }
  return out
}
function is_word(s, pos, w,   before, after) {
  if (substr(s, pos, length(w)) != w) return 0
  before = (pos > 1) ? substr(s, pos - 1, 1) : " "
  after = substr(s, pos + length(w), 1)
  if (before ~ /[A-Za-z0-9_.\/-]/) return 0
  if (after ~ /[A-Za-z0-9_-]/) return 0
  return 1
}
