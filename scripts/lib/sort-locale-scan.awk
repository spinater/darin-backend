# ตัวอ่านจุดเรียก `sort` ในไฟล์เชลล์หนึ่งใบ — ของ `scripts/check-sort-locale.sh` (ใบ 304)
#
# คายบรรทัดละหนึ่งจุดเรียก: <เลขบรรทัด> TAB <คำตัดสิน> TAB <ข้อความย่อ>
#
# คำตัดสิน:
#   DECLARED  มีคำนำหน้า `LC_ALL=` หรือ `LC_COLLATE=` ติดกับคำสั่งนี้ ⇒ **ผู้เขียนบอกออกมาแล้ว**
#             ว่ารอบนี้เรียงด้วย collation ไหน (ค่าที่ถูกเกือบทุกจุดคือ `C` = ลำดับไบต์)
#   BARE      ไม่มีเลย ⇒ ลำดับ **แล้วแต่เครื่องที่ยืนอยู่** ซึ่งไม่ใช่คำตอบที่ใครตั้งใจเลือก
#   NOTCMD    คำว่า `sort` อยู่ในตำแหน่ง *อาร์กิวเมนต์* ไม่ใช่ตำแหน่งคำสั่ง (`command -v sort`)
#             ⇒ **นอกขอบเขต** เพราะเติมคำนำหน้าให้มันไม่ได้ · ด่านนับแล้วพิมพ์ออกมาทุกรอบ
#             แทนที่จะข้ามเงียบ ๆ — เขตบอดที่ไม่มีตัวเลขคือเขตบอดที่ไม่มีใครเห็น
#
# ## ทำไมต้องมีตัวอ่าน ไม่ใช่ `grep -n sort`
#
# วัดบนคลังจริงวันเปิดใบ (ไฟล์เชลล์ 55 ใบ): `grep` ที่อ่านทีละบรรทัดดิบเจอคำว่า `sort` ในที่ซึ่ง
# **ไม่ใช่จุดเรียก** มากกว่าที่เป็นจุดเรียกเสียอีก และทุกแบบมีอยู่จริงในรีโปนี้:
#   · คอมเมนต์ไทยที่อ้างคำสั่ง — `# ห้ามนับด้วย sort | uniq -c` (กติกาของใบ 249 เขียนไว้เอง)
#   · โปรแกรม sed ในเครื่องหมายคำพูดเดี่ยว — `'s/LC_ALL=C sort/sort/g'` (แถวความไวของใบ 302)
#   · ร้อยแก้วในเครื่องหมายคำพูดคู่ · เนื้อ heredoc (`rows.sort()` ของสคริปต์ python ที่ฝังอยู่)
#   · เมธอดของภาษาอื่น — `rows.sort()` ไม่ใช่คำว่า `sort` (ตัวหน้าเป็น `.`)
# ⇒ ทั้งสี่แบบคือ **แดงปลอมในร้อยแก้ว** ซึ่งเป็นทางที่เร็วที่สุดที่จะทำให้คนเรียนรู้ที่จะเดินข้ามเกต
#
# 🔑 **คำตัดสินสองข้อนี้ยืมมา ไม่ได้เขียนใหม่** — "บรรทัดนี้เป็นข้อมูลใน heredoc ไหม" อยู่ที่
# `scripts/lib/heredoc.awk` (ใบ 318) · "ส่วนไหนของบรรทัดนี้เป็นโค้ด" กับ "คำนี้เป็นคำเดี่ยวไหม"
# อยู่ที่ `scripts/lib/shell-mask.awk` (ใบ 304 ย้ายออกมาจาก `scripts/lib/path-bytes-scan.awk`)
# ⇒ **ผู้เรียกต้องโหลดสามไฟล์คู่กันเสมอ**:
#   awk -f scripts/lib/heredoc.awk -f scripts/lib/shell-mask.awk -f scripts/lib/sort-locale-scan.awk <ไฟล์>
# โหลดไม่ครบ = awk มองเป็น "เรียกฟังก์ชันที่ไม่มี" แล้วตายทั้งรอบ ซึ่งดังพอ · แต่ตัวด่านยังมียาม
# อ่านไฟล์ครบไว้ข้างหน้าอีกชั้น
#
# ## เขตบอดที่ **ประกาศ** ไม่ใช่ซ่อน
#
#   · `export LC_ALL=C` ที่หัวไฟล์แล้วเรียก `sort` เปล่า ๆ — ถูกต้องจริงแต่ด่านจะฟ้อง · วัดแล้ว
#     **ศูนย์ไฟล์** ในคลังวันนี้ ⇒ ไม่เขียนโค้ดรับรูปที่ไม่มีใครใช้ (ยามที่จับคู่กับฉากที่มันไม่เคย
#     ทำงานคือยามที่วัดอะไรไม่ได้ — บทเรียนของใบ 190/314) · ทางออกพิมพ์ได้ทันที: ใส่คำนำหน้าให้จุดนั้น
#   · `sort` ที่เรียกผ่านตัวแปร (`S=sort; $S -u`) — มองไม่ทะลุ เหมือน `BADSUB` ของใบ 314
#   · 🔴 **เนื้อใน `'…'` ที่อยู่ข้างใน `$( )` ซึ่งอยู่ข้างใน `"…"` อีกที ถูกอ่านว่าเป็นโค้ด** —
#     ข้อจำกัดที่ติดมากับ `mask_and_strip` ตั้งแต่ใบ 314 (มันตามรอยเครื่องหมายคำพูดเดี่ยวที่ระดับ
#     บนสุดเท่านั้น) ⇒ เข็ม grep ที่มี backtick ฝังในรูปนั้นกลายเป็น **แดงปลอม** · เจอจริงตอน
#     รันเกตนี้ทับ selftest ของตัวเอง **สองจุด** (ไม่ใช่จากการอ่านโค้ด) · ทางออกพิมพ์ได้ทันที
#     และอ่านง่ายกว่าเดิม: ยกเข็มออกมาเป็นตัวแปรก่อน (ทำแล้วที่ `cases-behaviour.sh`)
#     ⚠️ **ไม่แก้ที่ `shell-mask.awk`** โดยตั้งใจ: ก้อนนั้นเป็นของที่ `check-path-bytes.sh` ใช้อยู่
#     ด้วย การแก้ไวยากรณ์ตรงนั้นเปลี่ยนคำตัดสินของอีกด่านหนึ่งในทางที่ต้องวัดใหม่ทั้งชุด ⇒ ถ้าวันหนึ่ง
#     รูปนี้โผล่มาเกินหนึ่งจุดในคลังจริง ให้เปิดใบใหม่แล้ววัดทั้งสองด่านพร้อมกัน ไม่ใช่แก้แถมมาในใบอื่น
#   · ด่านนี้ตอบว่า *ประกาศ locale หรือยัง* **ไม่ได้ตอบว่าประกาศถูกไหม**: `LC_ALL="" sort -u`
#     ผ่านด่าน เพราะจุดเดียวในคลังที่ประกาศเป็นค่าอื่นคือเทสที่ **วัดเรื่อง collation เอง**
#     (`scripts/tests/check-code-junit-selftest/cases-behaviour.sh`) ⇒ ห้ามเขียนกฎ "ต้องเป็น C
#     เท่านั้น" ซึ่งจะแดงใส่การวัดที่ถูกต้อง

BEGIN { FS = "\n" }
{
  raw = $0
  # ── heredoc: เนื้อในก้อนไม่ใช่โค้ด (คำตัดสินอยู่บ้านเดียวที่ `scripts/lib/heredoc.awk`)
  if (hd_skip(raw)) next
  # ── ต่อบรรทัดที่ลงท้ายด้วย `\` — รายงานที่ **บรรทัดกายภาพแรก** เสมอ
  if (buf == "") first = NR
  line = raw
  if (line ~ /\\$/) { sub(/\\$/, " ", line); buf = buf line; next }
  line = buf line; buf = ""
  ln = first
  code = mask_and_strip(line)
  if (code !~ /sort/) next
  for (p = 1; p <= length(code); p++) {
    if (!is_word(code, p, "sort")) continue
    # ── เดินถอยหลังข้าม **คำนำหน้าที่เป็นการกำหนดตัวแปร** (`FOO=bar LC_ALL=C sort`)
    # 🔴 ต้องเดินข้าม *ทุก* ตัว ไม่ใช่ตัวเดียว — `LC_ALL=C` ไม่จำเป็นต้องอยู่ติดคำสั่ง และ
    # การหยุดที่ตัวแรกจะอ่าน `LC_ALL=C LANG=C sort` ว่าไม่มีการประกาศ = แดงปลอมที่แก้ตามคำแนะนำ
    # ของเกตไม่ได้ · ค่าที่มีช่องว่างอยู่ข้างในไม่ทำให้พัง เพราะ `mask_and_strip` เป่าเนื้อใน
    # เครื่องหมายคำพูดเป็น \001 (ความยาวคงเดิม) ⇒ `LC_ALL="a b"` ยังเป็นคำเดียว
    q = p - 1
    saw = 0
    verdict = ""
    while (verdict == "") {
      while (q >= 1 && substr(code, q, 1) ~ /[ \t]/) q--
      if (q < 1) { verdict = saw ? "DECLARED" : "BARE"; break }
      ch = substr(code, q, 1)
      # ต้นคำสั่งจริง: หลัง `| & ; ( ) { } \` !` — `)` เพราะรูป `$(…)` ที่จบแล้วตามด้วยท่อไม่มี
      if (ch ~ /[|&;(){}`!]/) { verdict = saw ? "DECLARED" : "BARE"; break }
      e = q
      while (q >= 1 && substr(code, q, 1) !~ /[ \t|&;(){}`<>]/) q--
      w = substr(code, q + 1, e - q)
      if (w ~ /^(LC_ALL|LC_COLLATE)=/) { saw = 1; continue }
      if (w ~ /^[A-Za-z_][A-Za-z0-9_]*=/) continue
      if (w ~ /^(then|else|do|if|while|until|elif|command|builtin|exec|time)$/) {
        verdict = saw ? "DECLARED" : "BARE"
        # `command -v sort` / `command sort` ต่างกัน — ตัวแรกคือการ *ถาม* ไม่ใช่การเรียง
        # แต่แยกสองรูปนี้ต้องอ่านธงของ `command` ซึ่งเป็นลิสต์ที่ต้องมีคนเติม ⇒ ปล่อยให้เป็น
        # ตำแหน่งคำสั่งทั้งคู่ · ถ้าวันหนึ่งมีจุดแบบแรกจริง มันจะดังแล้วคนตัดสินใจได้
        break
      }
      verdict = "NOTCMD"
      break
    }
    snip = code; gsub(/\001/, "x", snip); sub(/^[ \t]+/, "", snip); sub(/[ \t]+$/, "", snip)
    if (length(snip) > 100) snip = substr(snip, 1, 100) "…"
    printf "%d\t%s\t%s\n", ln, verdict, snip
  }
}
