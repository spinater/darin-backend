# อยู่ในทิศนี้ — ประกาศไว้ ไม่ได้ปิด และห้ามเขียนที่ไหนว่าปิดแล้ว
#
# 🔴 **บรรทัดปิดต้องถูกรู้จัก มิฉะนั้นไฟล์ที่เหลือมืดทั้งใบแบบเงียบ ๆ** — ซึ่งเป็นโรคเดียวกับที่
# ใบนี้เปิดมาปิด แค่มาทางประตูใหม่ ⇒ มีเคสกับแถวความไวผูกไว้ทั้งสองด่าน
function hd_skip(raw,   t) {
  if (HD != "") { if (raw ~ ("^[ \t]*" HD "[ \t]*$")) HD = ""; return 1 }
  if (raw ~ /<<-?[ \t]*'?"?[A-Za-z_][A-Za-z0-9_]*'?"?[ \t]*$/ && raw !~ /<<</) {
    t = raw; sub(/^.*<<-?[ \t]*/, "", t); gsub(/['"]/, "", t); sub(/[ \t]*$/, "", t)
    if (t != "") { HD = t; return 1 }
  }
  return 0
}
