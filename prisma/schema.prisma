generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────── คน + สิทธิ์
model Staff {
  id           String  @id @default(cuid())
  name         String
  username     String  @unique
  passwordHash String
  role         String // owner | admin | counter | trainer
  rank         String? // ST | CT | PT  (เฉพาะ trainer)
  baseSalary   Int     @default(0)
  classCredit  Int     @default(0)
  active       Boolean @default(true)

  sessions      Session[]
  teachSessions TeachSession[]
  classSessions ClassSession[]
  attributions  SaleAttribution[]
  otEntries     OtEntry[]
  payslips      Payslip[]
  aliases       TrainerAlias[]
}

model Session {
  id        String   @id @default(cuid())
  staffId   String
  expiresAt DateTime
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────── config (ห้าม hardcode)

/// The registry of teach-activity **names** — one row per name an owner has declared exists.
///
/// 🔴 It holds no money and must never hold a number: a rate lives in `TeachRate` alone (§2 rules 2
/// and 3). Its reason to exist is that "this activity exists" and "this activity has a rate" had to
/// become two separate facts (task 036) — the full account is in
/// `.docs/knowledge/domain/payslip-lifecycle.md`.
///
/// 🔴 **No FK points here from `TeachRate.activity` or `TeachSession.activity`, on purpose.**
/// `lib/sync.ts` writes `activity: source.activity` on every synced cell, so a constraint would
/// turn a data-quality problem into a throw on the sync path — against §2 rule 6, which says
/// unmatched rows go to the review queue *and the payroll run still completes*. `lib/activities.ts`
/// therefore treats this table as one arm of a union that only ever **adds** names: an activity with
/// a rate row, a sheet source or one historical session still renders in the rate matrix even if
/// this table is empty, so no rate can become invisible because a registry row is missing.
///
/// `name` is compared **trimmed-exact — no case folding, no normalizer** (`lib/normalize.ts` is for
/// trainer names; a second normalizer would be one decision in two homes). `Boxing` and `boxing` are
/// therefore two names, and the mismatched one warns loudly instead of paying wrong.
model TeachActivity {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model TeachRate {
  id       String @id @default(cuid())
  activity String // pt | pilates | swim | yoga
  rank     String // PT | CT | ST
  rate     Int

  @@unique([activity, rank])
}

model PayrollConfig {
  key   String  @id
  value String
  note  String?
}

model ClassPrice {
  id     String  @id @default(cuid())
  name   String  @unique
  price  Int
  active Boolean @default(true)

  classSessions ClassSession[]
}

/// สีพื้นในชีต → ความหมาย (§1.6) แก้ในหน้า admin
model ColorRule {
  hex     String  @id // "#b6d7a8"
  meaning String // pay | skip | review
  note    String?
}

// ─────────────────────────────────────────── Google Sheet sync
model SheetSource {
  id            String    @id @default(cuid())
  spreadsheetId String
  sheetName     String
  activity      String // pt | pilates | swim | yoga
  colMap        Json // {name,nickname,phone,signup,count,trainer,firstSession}
  headerRows    Int       @default(1)
  active        Boolean   @default(true)
  lastSyncAt    DateTime?

  rows     SheetRowRaw[]
  sessions TeachSession[]

  @@unique([spreadsheetId, sheetName])
}

model SheetRowRaw {
  id       String      @id @default(cuid())
  sourceId String
  rowIndex Int
  cells    Json // [{v,f,bg,note}]
  syncedAt DateTime    @default(now())
  source   SheetSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, rowIndex])
}

model TrainerAlias {
  alias   String @id // normalize แล้ว
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

/// เวลาที่งานหนัก (ที่ไม่ใช่ sync) ใช้จริงรอบล่าสุด — เอาไว้บอกผู้ใช้ล่วงหน้าว่าต้องรอนานแค่ไหน
/// เก็บแค่ค่าล่าสุดพอ ไม่ต้องมีประวัติเหมือน SyncRun เพราะใช้แค่ตั้งต้นนับถอยหลัง
model JobDuration {
  job        String   @id // "payroll"
  ms         Int
  finishedAt DateTime @updatedAt
}

/// ประวัติการ sync — มีไว้บอกผู้ใช้ว่า "รอบนี้น่าจะใช้เวลาเท่าไร" จากเวลาที่วัดได้จริง
/// ไม่ใช่ตัวเลขที่ hardcode ไว้ (เครื่องช้า/ชีตโตขึ้น ตัวเลขจะขยับตามเอง)
model SyncRun {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  /// เวลาช่วงดึงข้อมูลจาก Google Sheet (ms) — แยกจากช่วงประมวลผลเพราะคนละคอขวด
  fetchMs     Int?
  /// เวลาช่วงเขียนลง DB (ms)
  processMs   Int?
  /// จำนวนหน่วยงานที่เขียนจริง (แถวดิบ + คาบสอน) — ใช้คิด ms ต่อหน่วย
  units       Int?
  ok          Int?
  needsReview Int?
  ignored     Int?
  /// null = สำเร็จ · มีค่า = พังกลางทาง (ไม่เอาไปคิดค่าประมาณ)
  error       String?

  @@index([startedAt])
}

model TeachSession {
  id            String    @id @default(cuid())
  sourceId      String
  rowIndex      Int
  colIndex      Int
  date          DateTime?
  activity      String
  staffId       String?
  customerName  String?
  customerPhone String?
  rawValue      String
  bgColor       String?
  status        String    @default("ok") // ok | needs_review | ignored
  reviewNote    String?
  /// true = คนแก้ด้วยมือแล้ว sync ครั้งหน้าห้ามทับ
  reviewed      Boolean   @default(false)

  source SheetSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  // Restrict: ห้ามลบพนักงานที่มีคาบสอนอยู่ (ให้ปิดใช้งานแทน)
  // ถ้าเป็น SetNull คาบจะกลายเป็น status=ok แต่ไม่มีผู้สอน → หลุดทั้งจากสลิปและคิวรอตรวจ
  staff  Staff?      @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([sourceId, rowIndex, colIndex])
  @@index([date, staffId, status])
}

// ─────────────────────────────────────────── คีย์มือ + นำเข้าจาก Gymmo
model ClassSession {
  id      String   @id @default(cuid())
  date    DateTime
  classId String
  staffId String
  booked  Int
  noShow  Int      @default(0)

  /// The identity of **one row of one Gymmo worklog export** — sheet + date + `timeText` + the raw
  /// class name, JSON-encoded as a 4-tuple by `gymmoSourceKey()` (`lib/gymmo-import.ts`).
  ///
  /// 🔴 **It exists so that importing the same file twice cannot pay twice** (task 063 §1). Before
  /// it, `ClassSession` had no key but `id`, so a second upload doubled every คาบ with nothing
  /// going red — money that is only noticed at payday, the most expensive failure this system has
  /// (§2 rule 4).
  ///
  /// **`booked`/`noShow` are deliberately NOT part of the key.** Gymmo lets staff correct
  /// attendance after the fact, so the same session arriving with a new count must **update** this
  /// row, never insert a second one.
  ///
  /// ⛔ **`date + classId + staffId` was rejected as the key**: the date is UTC midnight with the
  /// clock kept in `timeText` (see `lib/gymmo.ts`), and one trainer really does teach the same
  /// class twice in a day — that key would swallow one of the two คาบ silently.
  ///
  /// `null` for a row keyed by hand at `/classes`: it has no row in any file to be the identity of.
  /// A null is exempt from `@unique` in PostgreSQL, so hand-keyed rows never collide with each
  /// other — and never with an imported one either, which is why the import also reports how many
  /// hand-keyed คาบ already sit in the range it is about to write (`lib/gymmo-import-run.ts`).
  sourceKey String? @unique

  class ClassPrice @relation(fields: [classId], references: [id])
  staff Staff      @relation(fields: [staffId], references: [id])

  @@index([date, staffId])
}

/// One row of a Gymmo worklog export that did **not** become a `ClassSession`, with the reason —
/// the `ClassSession`-side equivalent of `TeachSession.status = "needs_review"` (task 064).
///
/// It exists because **the payslip cannot warn about a row that does not exist**: ~20 `Pilates Flow`
/// คาบ/month (~8,000 ฿ of class value) were reported once on the import screen and then ceased to
/// exist with the request, leaving a slip with `warnings: []` and nothing in any queue
/// (CLAUDE.md §2 rule 4).
///
/// 🔴 **NO FK POINTS AT `ClassSession`, ON PURPOSE** — the same shape of decision as
/// `TeachActivity`: the whole point of a row here is that the `ClassSession` does **not** exist, so a
/// nullable FK would be a column that is null on every row by construction. It carries the display
/// columns a join would have provided instead, and they are not redundant with the key: the key's
/// trainer half is `normalizeTrainer` output, which is **not a display name**. No `staffId` either,
/// even nullable — half these rows exist *because* the trainer could not be resolved, and an
/// unconstrained id column is a dangling reference by another name. A later screen resolves
/// `trainerSheet` through `matchTrainer` at read time (§2 rule 6: one home).
///
/// 🔴 **It holds NO MONEY and must never hold a number of baht** (§2 rules 2 and 3). The only thing
/// that turns คาบ into an amount is `computePayslip`, over `ClassSession` rows — which by definition
/// do not exist for any key in this table. A baht figure here would be a second path to an amount
/// **and** a rate read outside `PayrollConfig`/`ClassPrice`.
///
/// Written by `applyGymmoImport` alone (`lib/gymmo-import-run.ts`), **delete-then-insert over the
/// keys one file mentions**, inside the import's own transaction — the `PayslipWarning` pattern
/// ("rewritten whole on every recompute") scoped to a file instead of to a slip. That is what makes
/// a corrected re-upload unable to leave an old reason behind, and what bounds the table's growth to
/// distinct real คาบ rather than to upload attempts.
model ClassImportProblem {
  /// Identity, and the whole design. `JSON.stringify` of 4 / 2 / 1 elements, kept apart by **arity**
  /// so the three shapes cannot collide — see `lib/class-problems.ts`.
  ///
  /// 🔴 For the 4-tuple it is **byte-for-byte `gymmoSourceKey(row)`**, produced by calling that
  /// function, never re-derived. That equality is the entire clearing mechanism: one byte of drift
  /// and the delete never matches, so a คาบ that now imports cleanly stays queued for ever and
  /// `/payslips` blocks a period that is in fact clean. Pinned in `lib/class-problems.test.ts`.
  key          String    @id
  /// `"session"` = it has a real `sourceKey`, so an import that writes that คาบ into an **open**
  /// period clears it ·
  /// `"duplicate"` = also a real `sourceKey`, but the file holds **two** rows for it with different
  /// head counts, so an existing `ClassSession` says nothing about the amount and the count never
  /// excludes it ·
  /// 🔴 `"row"` = the reader never got a `sourceKey`, and **nothing clears this row at all**: the
  /// same คาบ, once the cell is fixed, is written under a 4-tuple `sourceKey` while this row is keyed
  /// by the 3-tuple `[sheet, #, rawWhen]`, so no `deleteMany` can ever match it. Task 066's
  /// dismissal is its only exit — do not write anywhere that a re-upload makes it disappear.
  kind         String
  /// `"<sheet> แถว <n>"`, as the import screen already renders it. Named `rowLabel` and **not**
  /// `where`: a column called `where` collides with Prisma's own query argument on every call
  /// against this model (`findFirst({ where: { where } })`). `GymmoProblem.where` keeps its name in
  /// the type the screen renders.
  rowLabel     String
  reason       String
  /// The trainer as the **file** spelled it — never the normalized half of the key, which is not a
  /// display name (`ธันยามูลละคร`). The sheet name for a reader reject.
  trainerSheet String
  /// The raw class name, as keyed. `null` for a reader reject.
  className    String?
  /// UTC calendar day, as `lib/gymmo.ts` reads it. `null` **only** when the date itself was the
  /// unreadable part (or for a whole-sheet reject) — every other reader reject happens *after*
  /// `parseGymmoWhen` succeeded and carries its date, which is what keeps it scoped to one month.
  /// A `null` is counted in **every** period, exactly as `pendingReviewInPeriod` counts a
  /// `TeachSession` with `date: null`, and since a `"row"` problem has no clearing path that is
  /// permanent until task 066 answers — which is why defaulting this column would be expensive.
  date         DateTime?
  timeText     String?
  /// The last import that saw this problem. A row older than `MAX(seenAt)` is one the latest file
  /// did not mention. There is deliberately no `firstSeenAt`: the row is recreated on every import,
  /// so "first seen" could only be honest if the write became an upsert per row — the round-trip
  /// loop task 063 rejected inside Prisma's 5 s interactive budget.
  seenAt       DateTime  @default(now())

  @@index([date])
}

model Sale {
  id          String   @id @default(cuid())
  date        DateTime
  kind        String // pt | membership | course_ext | freeze
  tier        String? // basic | premium | platinum | pilates
  productName String
  listPrice   Float?
  netPrice    Float
  note        String?

  attributions SaleAttribution[]

  @@index([date, kind])
}

model SaleAttribution {
  id      String @id @default(cuid())
  saleId  String
  staffId String
  role    String // closer | referrer | content_owner

  sale  Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([saleId, staffId, role])
}

model OtEntry {
  id      String   @id @default(cuid())
  staffId String
  date    DateTime
  hours   Float
  staff   Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
}

// ─────────────────────────────────────────── ผลลัพธ์
model Payslip {
  id         String   @id @default(cuid())
  staffId    String
  period     String // "2026-07"
  base       Float
  teachPay   Float
  classPay   Float
  commission Float
  otPay      Float
  net        Float
  status     String   @default("draft") // draft | approved | paid
  createdAt  DateTime @default(now())

  staff    Staff            @relation(fields: [staffId], references: [id])
  lines    PayslipLine[]
  warnings PayslipWarning[]

  @@unique([staffId, period])
}

model PayslipLine {
  id        String @id @default(cuid())
  payslipId String
  group     String // base | teach | class | commission | ot
  label     String
  qty       Float
  rate      Float
  amount    Float

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
}

/// What the engine could not decide for this payslip (CLAUDE.md §2 rule 4).
/// Produced only by computePayslip() and rewritten whole on every recompute, exactly like
/// PayslipLine. Deliberately NOT a workflow: no severity, no acknowledgedAt, no resolvedBy —
/// task 009 shows the undecided cases, it does not decide them.
model PayslipWarning {
  id        String @id @default(cuid())
  payslipId String
  /// Emission order from computePayslip(). A table has no implicit order; this column is what
  /// makes it equal to the string[] the engine returns, and the unique below turns a missing
  /// deleteMany into a loud insert failure instead of a silently doubled list.
  seq       Int
  message   String

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@unique([payslipId, seq])
}

// ─────────────────────────────────────────── bootstrap

/// Written once, by `prisma/seed.ts`, at the **end** of the run that first planted — or adopted —
/// this database. Its **absence** is the only thing that lets the seed write reference data; its
/// presence makes every later deploy read-only outside the `CONFIG_DEFAULTS` key set (task 040).
///
/// Written last on purpose, and paired with a second witness: a first boot that crashes leaves no
/// mark, and whether the next run re-attempts the fixture is decided by `Staff.count()`, not by
/// this row. The `Staff` + `TrainerAlias` block is therefore one `db.$transaction` and is written
/// after every other fixture table, so that count can only read **0** (nothing committed ⇒ the
/// whole fixture is re-attempted over upserts on unique keys) or **7** (committed over a complete
/// fixture ⇒ the retry adopts and withholds nothing that is missing).
///
/// ⚠️ **The retry is not idempotent in one respect, and it cannot be made so.** A crash between
/// that commit and the credential `console.log` leaves an owner row holding a generated password
/// that was never printed; the next run reads `adopt` and will not print it, so nobody can log in
/// to `/admin/config`. Printing before the commit would hand out a credential for a run that may
/// roll back. Pass `OWNER_PASSWORD` to `migrate` and the window costs nothing.
///
/// The row itself is written with `createMany … skipDuplicates`: two overlapping `migrate`
/// containers both reach it, and a bare `create` would fail the loser with P2002 and take `app`
/// down with it (`depends_on: … service_completed_successfully`).
model SeedMark {
  name String   @id // "bootstrap"
  mode String // "planted" | "adopted"
  at   DateTime @default(now())
}
